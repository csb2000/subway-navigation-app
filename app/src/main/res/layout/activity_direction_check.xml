<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0d1b2a"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="출발 방향 확인"
            android:textColor="#99FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvDirectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="올바른 방향을 찾는 중..."
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/tvDestInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="목적지: 승강장"
            android:textColor="#5dcaa5"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- 방향 상태 표시 (중앙 큰 영역) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- 방향 상태 텍스트 -->
        <TextView
            android:id="@+id/tvDirectionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="몸을 천천히 돌려주세요"
            android:textSize="20sp"
            android:textColor="#222222"
            android:gravity="center"
            android:background="#F5F5F5"
            android:padding="24dp"
            android:layout_marginBottom="20dp"
            android:contentDescription="방향 상태 안내" />

        <!-- 각도 표시 -->
        <TextView
            android:id="@+id/tvAngleDiff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="현재 각도 차이: 측정 중"
            android:textSize="16sp"
            android:textColor="#888888"
            android:gravity="center"
            android:layout_marginBottom="12dp" />

        <!-- 진동 안내 강도 표시 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#F5F5F5"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="진동 안내"
                android:textSize="13sp"
                android:textColor="#888888"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvVibrationInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="진동 없음"
                android:textSize="16sp"
                android:textColor="#222222" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="방향이 맞으면 진동이 빨라집니다"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 방향 맞으면 출발 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/btnStartMove"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:text="이 방향으로 출발"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0d1b2a"
            android:contentDescription="이 방향으로 출발. 현재 방향으로 이동을 시작합니다. 두 번 탭하여 활성화."
            android:enabled="false" />
    </LinearLayout>
</LinearLayout>