<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:gravity="center">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <TextView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:text="완료"
            android:textSize="18sp"
            android:textColor="#3b6d11"
            android:gravity="center"
            android:background="#EAF3DE"
            android:layout_marginBottom="20dp"
            android:contentDescription="도착 완료" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="목적지에 도착하였습니다"
            android:textSize="22sp"
            android:textColor="#222222"
            android:gravity="center"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvArriveDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="승강장까지\n안전하게 이동했습니다.\n수고하셨습니다."
            android:textSize="16sp"
            android:textColor="#888888"
            android:gravity="center"
            android:lineSpacingMultiplier="1.6"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btnGoHome"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:text="처음 화면으로"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0d1b2a"
            android:contentDescription="처음 화면으로 돌아가기. 두 번 탭하여 활성화." />
    </LinearLayout>
</LinearLayout>