<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0d1b2a"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:importantForAccessibility="yes"
        android:accessibilityLiveRegion="polite">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="현재 위치"
            android:textColor="#99FFFFFF"
            android:textSize="14sp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tvCurrentLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="위치 측정 중..."
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:contentDescription="현재 위치: 위치 측정 중"
            android:accessibilityLiveRegion="polite" />

        <TextView
            android:id="@+id/tvLocStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="위치 인식됨"
            android:textColor="#5dcaa5"
            android:textSize="13sp"
            android:accessibilityLiveRegion="polite" />

        <TextView
            android:id="@+id/tvWifiStrength"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/tvSelectedDestination"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp"
        android:background="#1a2a3a"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp"
        android:focusable="true"
        android:clickable="true"
        android:contentDescription="목적지 설정 버튼. 경로 안내를 시작합니다.">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:importantForAccessibility="no">

            <Button
                android:id="@+id/btnSetDestination"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@null"
                android:padding="0dp"
                android:text="목적지 설정"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:contentDescription="목적지 설정. 경로 안내를 시작합니다."
                android:importantForAccessibility="yes" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="경로 안내를 시작합니다"
                android:textColor="#99FFFFFF"
                android:textSize="13sp"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:background="#1a2a3a"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp"
        android:focusable="true"
        android:clickable="true"
        android:contentDescription="현 위치 확인 버튼. 와이파이 신호로 위치를 재측정합니다.">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:importantForAccessibility="no">

            <Button
                android:id="@+id/btnCheckLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@null"
                android:padding="0dp"
                android:text="현 위치 확인"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:contentDescription="현 위치 확인. 와이파이 신호로 위치를 재측정합니다."
                android:importantForAccessibility="yes" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WiFi 신호로 재측정"
                android:textColor="#99FFFFFF"
                android:textSize="13sp"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:importantForAccessibility="no" />
    </LinearLayout>

</LinearLayout>