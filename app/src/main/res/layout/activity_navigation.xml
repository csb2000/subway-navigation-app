<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- 상단 안내 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#0d1b2a"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvNodeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="승강장까지"
            android:textColor="#99FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvNodeStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1번째 노드 이동 중"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/tvNextNodeInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="다음 노드까지 직진"
            android:textColor="#5dcaa5"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- 본문 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 노드 진행 상황 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F5F5F5"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="경로 진행 상황"
                    android:textSize="13sp"
                    android:textColor="#888888"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/nodeProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:contentDescription="노드 진행 상황" />

                <TextView
                    android:id="@+id/tvNodeProgressText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="노드 1 / 전체 5"
                    android:textSize="14sp"
                    android:textColor="#222222"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

            <!-- 위치 수집 상태 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F5F5F5"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="위치 수집"
                    android:textSize="13sp"
                    android:textColor="#888888"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvCollectStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1초마다 서버 전송 중..."
                    android:textSize="16sp"
                    android:textColor="#0f6e56" />

                <TextView
                    android:id="@+id/tvLastSent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="마지막 전송: -"
                    android:textSize="13sp"
                    android:textColor="#888888"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- 위험 구간 안내 (에스컬레이터 노드 접근 시 표시) -->
            <LinearLayout
                android:id="@+id/layoutDangerAlert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFF0F0"
                android:padding="16dp"
                android:layout_marginBottom="14dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="주의"
                    android:textSize="13sp"
                    android:textColor="#a32d2d"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvDangerText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="에스컬레이터 구간입니다"
                    android:textSize="18sp"
                    android:textColor="#a32d2d"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 하단 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <Button
            android:id="@+id/btnNodeArrived"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:text="노드 도착 확인"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0d1b2a"
            android:contentDescription="노드 도착 확인. 현재 노드에 도착했습니다. 두 번 탭하여 활성화."
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnStopNav"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="안내 종료"
            android:textSize="16sp"
            android:textColor="#222222"
            android:backgroundTint="#E0E0E0"
            android:contentDescription="안내 종료. 두 번 탭하여 활성화." />
    </LinearLayout>
</LinearLayout>