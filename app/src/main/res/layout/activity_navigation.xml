<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- 상단 다크 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0d1b2a"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="직진으로"
            android:textColor="#99FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvNodeStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="이동하세요"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="✓ 올바른 방향 · 약 15초"
            android:textColor="#5dcaa5"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 노드 진행 표시바 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0d1b2a"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/circle_green"
            android:gravity="center"
            android:text="1"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_weight="1"
            android:background="#5dcaa5" />

        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/circle_white"
            android:gravity="center"
            android:text="2"
            android:textColor="#0d1b2a"
            android:textSize="13sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_weight="1"
            android:background="#444444" />

        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/circle_dark"
            android:gravity="center"
            android:text="3"
            android:textColor="#888888"
            android:textSize="13sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_weight="1"
            android:background="#444444" />

        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/circle_dark"
            android:gravity="center"
            android:text="🚩"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 노드 정보 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F5F5F5"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvNextNodeInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2번 출구까지 · 3단계 남음"
                android:textColor="#888888"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvNodeProgressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="현재 노드 2 / 4"
                android:textColor="#222222"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 위험 알림 -->
        <LinearLayout
            android:id="@+id/layoutDangerAlert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFEEEE"
            android:orientation="horizontal"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠ "
                android:textColor="#CC0000"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="계단 구간입니다. 주의하세요."
                android:textColor="#CC0000"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 숨겨진 뷰 (코드 호환용) -->
        <TextView
            android:id="@+id/tvNodeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvLastSent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

    </LinearLayout>

    <!-- 하단 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <Button
            android:id="@+id/btnNodeArrived"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginBottom="12dp"
            android:backgroundTint="#1a7a56"
            android:text="✓ 도착 확인"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnStopNav"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:backgroundTint="#00000000"
            android:text="× 안내 종료"
            android:textColor="#888888"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>